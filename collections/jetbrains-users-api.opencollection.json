{
  "opencollection": "1.0.0",
  "info": {
    "name": "JetBrains Hub REST Activities Users API",
    "version": "2024.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JetBrains List Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/users",
            "params": [
              {
                "name": "fields",
                "value": "",
                "type": "query"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query"
              },
              {
                "name": "$top",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of Hub users."
        },
        {
          "info": {
            "name": "JetBrains Get User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns details of a specific user."
        },
        {
          "info": {
            "name": "JetBrains Get Current User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/users/me"
          },
          "docs": "Returns the currently authenticated user."
        }
      ]
    }
  ],
  "bundled": true
}