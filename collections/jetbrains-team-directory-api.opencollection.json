{
  "opencollection": "1.0.0",
  "info": {
    "name": "JetBrains Hub REST Activities Team Directory API",
    "version": "2024.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Team Directory",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JetBrains List Team Members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/team-directory/profiles"
          },
          "docs": "Returns a list of team member profiles."
        },
        {
          "info": {
            "name": "JetBrains List Teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/team-directory/teams"
          },
          "docs": "Returns a list of teams in the organization."
        }
      ]
    }
  ],
  "bundled": true
}