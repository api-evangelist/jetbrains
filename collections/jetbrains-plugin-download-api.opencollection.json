{
  "opencollection": "1.0.0",
  "info": {
    "name": "JetBrains Hub REST Activities Plugin Download API",
    "version": "2024.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Plugin Download",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JetBrains Download Plugin",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/plugin/download",
            "params": [
              {
                "name": "pluginId",
                "value": "",
                "type": "query"
              },
              {
                "name": "version",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Downloads a specific version of a plugin."
        }
      ]
    }
  ],
  "bundled": true
}