{
  "opencollection": "1.0.0",
  "info": {
    "name": "JetBrains Hub REST Activities Issues API",
    "version": "2024.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Issues",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JetBrains List Issues",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/issues",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query"
              },
              {
                "name": "$top",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of issues matching the query."
        },
        {
          "info": {
            "name": "JetBrains Create Issue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/issues",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new issue."
        },
        {
          "info": {
            "name": "JetBrains Get Issue",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/issues/:issueId",
            "params": [
              {
                "name": "issueId",
                "value": "",
                "type": "path"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns details of a specific issue."
        },
        {
          "info": {
            "name": "JetBrains Update Issue",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/issues/:issueId",
            "params": [
              {
                "name": "issueId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing issue."
        },
        {
          "info": {
            "name": "JetBrains Delete Issue",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/issues/:issueId",
            "params": [
              {
                "name": "issueId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes an issue."
        },
        {
          "info": {
            "name": "JetBrains List Issue Comments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/issues/:issueId/comments",
            "params": [
              {
                "name": "issueId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns comments for an issue."
        },
        {
          "info": {
            "name": "JetBrains Add Issue Comment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/issues/:issueId/comments",
            "params": [
              {
                "name": "issueId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds a comment to an issue."
        }
      ]
    }
  ],
  "bundled": true
}