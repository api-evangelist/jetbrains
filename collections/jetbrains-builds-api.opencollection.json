{
  "opencollection": "1.0.0",
  "info": {
    "name": "JetBrains Hub REST Activities Builds API",
    "version": "2024.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Builds",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JetBrains List Builds",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/builds",
            "params": [
              {
                "name": "locator",
                "value": "",
                "type": "query"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a list of builds matching the specified locator."
        },
        {
          "info": {
            "name": "JetBrains Get Build",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/builds/:buildLocator",
            "params": [
              {
                "name": "buildLocator",
                "value": "",
                "type": "path"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns details of a specific build."
        }
      ]
    }
  ],
  "bundled": true
}