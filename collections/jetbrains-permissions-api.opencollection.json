{
  "opencollection": "1.0.0",
  "info": {
    "name": "JetBrains Hub REST Activities Permissions API",
    "version": "2024.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Permissions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JetBrains List Permissions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/permissions"
          },
          "docs": "Returns a list of permissions."
        }
      ]
    }
  ],
  "bundled": true
}