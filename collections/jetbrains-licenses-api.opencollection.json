{
  "opencollection": "1.0.0",
  "info": {
    "name": "JetBrains Hub REST Activities Licenses API",
    "version": "2024.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Licenses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JetBrains Check Plugin License",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.youtrack.cloud/hub/api/rest/api/marketplace/plugin/:productCode/license",
            "params": [
              {
                "name": "productCode",
                "value": "",
                "type": "path"
              },
              {
                "name": "email",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Checks the license status for a plugin."
        }
      ]
    }
  ],
  "bundled": true
}